{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umaparty-fan-tracker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets: the Vite build output. `single-page-application` makes the
  // Worker serve index.html for unknown paths so client-side routing works,
  // while /api/* still hits the Worker because run_worker_first matches it.
  // Asset requests bypass the Worker entirely unless listed in
  // run_worker_first, so asset cache headers cannot be set in code without
  // routing every request through the Worker. Cloudflare's default of
  // `max-age=0, must-revalidate` is used instead, which revalidates on every
  // request and so cannot serve a stale bundle. A `_headers` file does NOT
  // work here — that is a Pages feature; Static Assets just serves the file.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "umaparty",
      "database_id": "f5365a1e-d285-4b0f-bd44-9d2872ac0dfb",
      "migrations_dir": "migrations"
    }
  ],

  // Chrono refreshes after 10:00 UTC. The 15:00 pass exists because on the 1st
  // of the month the club-level tables land five hours later than the member
  // ones. Both runs are idempotent, so the second is a no-op on normal days.
  "triggers": {
    "crons": ["15 10 * * *", "15 15 * * *"]
  },

  "observability": {
    "enabled": true
  },

  // Deployed value. `wrangler dev` overrides it from .dev.vars, which is how
  // the local ingest trigger at /api/__ingest is enabled — it is denied unless
  // ENVIRONMENT is explicitly "development".
  "vars": {
    "ENVIRONMENT": "production"
  }

  // Secrets, set via `wrangler secret put` — never in this file:
  //   CHRONO_TOKEN    chronogenesis API token (Authorization header, no Bearer)
  //   SESSION_SECRET  HMAC key for officer session cookies
}
